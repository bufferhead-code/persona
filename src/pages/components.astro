---
import Layout from '../layouts/Layout.astro';
import AboutSectionOne from "../components/About/AboutSectionOne.astro";
import AboutSectionTwo from "../components/About/AboutSectionTwo.astro";

import ExperienceSectionOne from "../components/Experience/ExperienceSectionOne.astro";
import ExperienceSectionTwo from "../components/Experience/ExperienceSectionTwo.astro";
import EndorsementSection from "../components/Endorsement/EndorsementSection.astro";
import StackSectionOne from "../components/Stack/StackSectionOne.astro";
import StackSectionTwo from "../components/Stack/StackSectionTwo.astro";
import ReferenceSectionOne from "../components/Reference/ReferenceSectionOne.astro";
import ReferenceSectionTwo from "../components/Reference/ReferenceSectionTwo.astro";
import ContactFormOne from "../components/Contact/ContactFormOne.astro";
import ContactFormTwo from "../components/Contact/ContactFormTwo.astro";
import MainSection from "../components/MainSection.astro";
import {SEO} from "astro-seo";

const items = [
    {
        title: 'About Section One',
        icon: "heroicons:user-circle",
        path: '/src/components/About/AboutSectionOne.astro',
        component: AboutSectionOne
    },
    {
        title: 'About Section Two',
        icon: "heroicons:user-circle",
        path: '/src/components/About/AboutSectionTwo.astro',
        component: AboutSectionTwo
    },
    {
        title: 'Experience Section One',
        icon: "heroicons:briefcase",
        path: '/src/components/Experience/ExperienceSectionOne.astro',
        component: ExperienceSectionOne
    },
    {
        title: 'Experience Section Two',
        icon: "heroicons:briefcase",
        path: '/src/components/Experience/ExperienceSectionTwo.astro',
        component: ExperienceSectionTwo
    },
    {
        title: 'Endorsement Section',
        icon: "heroicons:chat-bubble-left-right",
        path: '/src/components/Endorsement/EndorsementSection.astro',
        component: EndorsementSection
    },
    {
        title: 'Stack Section One',
        icon: "heroicons:code-bracket-square",
        path: '/src/components/Stack/StackSectionOne.astro',
        component: StackSectionOne
    },
    {
        title: 'Stack Section Two',
        icon: "heroicons:code-bracket-square",
        path: '/src/components/Stack/StackSectionTwo.astro',
        component: StackSectionTwo
    },
    {
        title: 'Reference Section One',
        icon: "heroicons:document-magnifying-glass",
        path: '/src/components/Reference/ReferenceSectionOne.astro',
        component: ReferenceSectionOne
    },
    {
        title: 'Reference Section Two',
        icon: "heroicons:document-magnifying-glass",
        path: '/src/components/Reference/ReferenceSectionTwo.astro',
        component: ReferenceSectionTwo
    },
    {
        title: 'Contact Form One',
        icon: "heroicons:chat-bubble-bottom-center-text",
        path: '/src/components/Contact/ContactFormOne.astro',
        component: ContactFormOne
    },
    {
        title: 'Contact Form Two',
        icon: "heroicons:chat-bubble-bottom-center-text",
        path: '/src/components/Contact/ContactFormOne.astro',
        component: ContactFormTwo
    },
];
---

<Layout>
    <Fragment slot="head">
        <SEO
                description="Build Astro websites superfast, with easy to customize themes."
                title="Components Overview - Persona Theme"
        />
    </Fragment>
    {
        items.map((item) => (
                <MainSection icon={item.icon} title={item.title}>
                        <item.component></item.component>
                    <div class="flex" slot="header-side">
                        <div class="bg-base-100 border min-w-0 truncate text-ellipsis border-base-200 rounded font-mono text-base-700 text-xs px-2 py-1 font-semibold">
                            {item.path}
                        </div>
                    </div>
                </MainSection>
        ))
    }
</Layout>
