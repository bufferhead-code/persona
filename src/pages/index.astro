---
import Layout from '../layouts/Layout.astro';
import MainSection from "../components/MainSection.astro";
import {sections} from "../config/sections";
import { SEO } from "astro-seo";
---

<Layout>
    <Fragment slot="head">
        <SEO
                description="Build Astro websites superfast, with easy to customize themes."
                title="Persona Theme - Bufferthemes"
        />
    </Fragment>
    {
        sections.map((item) => (
                <MainSection icon={item.icon} title={item.title} name={item.name}>
                    <item.component></item.component>
                </MainSection>
        ))
    }
</Layout>

<script>
    document.addEventListener('astro:page-load', () => {
        const sections = document.querySelectorAll("main section");
        const navLinks = document.querySelectorAll("nav a");

        let visibleSections: Array<Element> = [];

        const observer = new IntersectionObserver(
            (entries) => {
                // check all entries and add or remove them from visibleSections according to isIntersecting
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        visibleSections.push(entry.target);
                    } else {
                        visibleSections = visibleSections.filter((section) => section !== entry.target);
                    }
                });

                // get the first item in visibleSections according to the dom
                visibleSections = visibleSections.sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);
                if (visibleSections.length === 0) return;
                const entry = visibleSections[0];

                const activeLinks = Array.from(navLinks).filter(el => el.getAttribute("href") === '/#' + entry.getAttribute("id"));
                activeLinks.forEach((link) => link.setAttribute("aria-current", "page"));

                // remove from aria-current from all but activeLinks
                Array.from(navLinks).filter(el => !activeLinks.includes(el)).forEach((link) => link.removeAttribute("aria-current"));
            },
            {threshold: 0.2}
        );

        sections.forEach((section) => observer.observe(section));
    });

</script>
