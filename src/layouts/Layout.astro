---
import "../styles/global.css";
import { ClientRouter } from 'astro:transitions';
import Header from "../components/Header.astro";
import NavigationItem from "../components/NavigationItem.astro";
import {sections} from "../config/sections";
---


<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Persona Astro Theme</title>
		<ClientRouter />
	</head>
	<body>
	<main>
		<Header></Header>
		<div class="bg-base-50">
			<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
				<div class="mx-auto  grid max-w-2xl grid-cols-1 grid-rows-1 items-start gap-x-8 gap-y-8 lg:mx-0 lg:max-w-none lg:grid-cols-7">

					<div class="lg:sticky top-6 lg:col-start-1 lg:row-end-2 lg:col-span-2 row-start-2 row-span-1 lg:row-span-2">
						<div class=" bg-white border border-base-200    rounded-lg px-4 py-2">
							<nav class="flex flex-1  flex-col py-1 hidden md:block" aria-label="Sidebar">
								<ul class="-mx-2 space-y-1">
									{
										sections.map((item) => (
											<NavigationItem
												label={item.title}
												icon={item.icon}
												name={item.name}
											/>
										))
									}
								</ul>
							</nav>
						</div>
						<div class="px-4 py-4 flex gap-5 text-sm font-medium justify-center   transition">
							<a class="text-gray-500 hover:text-gray-700" href="/imprint">
								Imprint
							</a>
							<a class="text-gray-500 hover:text-gray-700" href="/components">
								Components
							</a>

						</div>


					</div>

					<div class="lg:col-start-3 bg-white ring-1  ring-base-900/5 sm:mx-0 sm:rounded-lg lg:col-span-5 lg:row-span-2 lg:row-end-2 shadow scroll-smooth">
						<main>
							<slot></slot>
						</main>
					</div>
				</div>
			</div>
		</div>

	</main>

	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
