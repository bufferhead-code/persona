---
import FormInputField from "../Form/FormInputField.astro";
import FormInputTextarea from "../Form/FormInputTextarea.astro";
import ButtonPrimary from "../Button.astro";
import { Icon } from "astro-icon/components";
import {socialIcons} from "../../config/social";
---

<div
  class="flex items-center justify-center px-4 py-8 container mx-auto relative irolate"
>
  <div
    class="overflow-hidden w-full flex gap-x-12 flex-col md:flex-row relative items-center"
  >
    <div>
      <h2 class="text-3xl font-bold mb-2">Work with me</h2>
      <p class="text-base-600 mb-6">
        Lorem aliquip sit consequat tempor voluptate cupidatat elit cillum
        consectetur duis.
      </p>
      <div class="flex space-x-4 mb-6">
        {
            socialIcons.map((item) => (
                <a href={item.url} class="text-base-400 hover:text-base-600">
                    <Icon name={item.icon} class="w-6 h-6" />
                </a>
            ))
        }
      </div>
      <form class="space-y-3">
        <FormInputField label="Name" name="name" />
        <FormInputField label="Email" name="email" />
        <FormInputTextarea label="Message" name="message" />
        <ButtonPrimary> Send </ButtonPrimary>
      </form>
    </div>
  </div>
</div>
