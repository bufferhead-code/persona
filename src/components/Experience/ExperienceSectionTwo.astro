---
import ExperienceRowTwo from "./ExperienceRowTwo.astro";
import acmeLogo from "@assets/placeholder/acme_square.svg";
import alphaWaveLogo from "@assets/placeholder/alphawave_square.svg";
import altShiftLogo from "@assets/placeholder/altshift_square.svg";
---

<div>
  <div>
    <ExperienceRowTwo
        image={acmeLogo}
        timeFrame="Jan 2010 - Feb 2015"
        position="Remote Full-Stack Developer"
        company="ACME Corp, World"
    />

    <ExperienceRowTwo
        image={alphaWaveLogo}
        timeFrame="Jan 2010 - Feb 2015"
        position="Remote Full-Stack Developer"
        company="ACME Corp, World"
    />

    <ExperienceRowTwo
        image={altShiftLogo}
        timeFrame="Jan 2010 - Feb 2015"
        position="Remote Full-Stack Developer"
        company="ACME Corp, World"
    />
  </div>
</div>
