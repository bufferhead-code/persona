---

import acmeLogo from "@assets/placeholder/acme.svg";

import alphawaveLogo from "@assets/placeholder/alphawave.svg";
import altshiftLogo from "@assets/placeholder/altshift.svg";
import boltshiftLogo from "@assets/placeholder/boltshift.svg";
import codecraftLogo from "@assets/placeholder/codecraft.svg";
import cubekitLogo from "@assets/placeholder/cubekit.svg";
import easytaxLogo from "@assets/placeholder/easytax.svg";
import eightballLogo from "@assets/placeholder/eightball.svg";
import euphoriaLogo from "@assets/placeholder/euphoria.svg";
import ReferenceItem from "./ReferenceItem.astro";
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 pb-5 gap-x-10">
    <ReferenceItem image={acmeLogo} title="Acme Inc."/>

    <ReferenceItem image={alphawaveLogo} title="AlphaWave"/>

    <ReferenceItem image={altshiftLogo} title="AltShift"/>

    <ReferenceItem image={boltshiftLogo} title="BoltShift"/>

    <ReferenceItem image={codecraftLogo} title="CodeCraft"/>

    <ReferenceItem image={cubekitLogo} title="CubeKit"/>

    <ReferenceItem image={easytaxLogo} title="EasyTax"/>

    <ReferenceItem image={eightballLogo} title="EightBall"/>

    <ReferenceItem image={euphoriaLogo} title="Euphoria"/>
</div>
