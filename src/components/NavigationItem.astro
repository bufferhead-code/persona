---
import { Icon } from 'astro-icon/components';

interface Props {
    label: string;
    icon: string;
    name: string;
}

const { label = false, icon, name } = Astro.props;

---

<li>
    <a href={'#' + name} class="w-full group flex group gap-x-3 rounded-md p-2 text-sm leading-6 font-semibold text-gray-700 hover:text-blue-600 hover:bg-gray-50 aria-[current]:border aria-[current]:border-gray-200 aria-[current]:bg-gray-50 aria-[current]:text-blue-600">
        <Icon 
            name={icon}
            class={`h-6 w-6 shrink-0 text-gray-400 group-hover:text-blue-600 group-aria-[current]:text-blue-600`}
        />
        {label}
    </a>
</li>
