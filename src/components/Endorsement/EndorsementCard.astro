---
import { Image } from "astro:assets";

interface Props {
  name: string;
  position: string;
  image?: ImageMetadata;
}

const { name, position, image } = Astro.props;
---

<div class="rounded-2xl border border-gray-200 bg-white px-4 py-3 ">
  <div class="flex items-center gap-3.5">
    {
      image && (
        <Image
          src={image}
          alt={name}
          class="h-10 w-10 rounded-full object-cover"
        />
      )
    }
    <div>
      <h3 class="font-medium text-sm">{name}</h3>
      <p class="text-gray-600 font-medium text-xs">{position}</p>
    </div>
  </div>

  <div class="mt-3 text-gray-700 text-sm  border-t border-gray-200 pt-3">
    <slot>
    </slot>
  </div>
</div>
