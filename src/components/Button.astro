---
import {twMerge} from "tailwind-merge";
interface Props {
    type?: "button" | "submit" | "reset";
    class?: string;
    href?: string;
    target?: string;
}

const {
    class: className,
    href,
    target,
    ...props
} = Astro.props;

---

{
    href ? (
        <a
            href={href}
            target={target}
            class:list={twMerge("rounded-md flex items-center space-x-2 bg-white px-3 py-2 text-sm font-semibold border border-gray-300 transition text-gray-900 shadow-sm hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600", className)}
            {...props}

        >
            <slot />
        </a>
    ) : (
        <button
                class:list={twMerge("rounded-md flex items-center space-x-2 bg-white px-3 py-2 text-sm font-semibold border border-gray-300 transition text-gray-900 shadow-sm hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600", className)}
                {...props}
        >
            <slot />
        </button>
    )
}