---
import {Icon} from "astro-icon/components";

interface Props {
    title: string;
    icon: string;
    name: string;
}

const {title, icon, name} = Astro.props;
---

<section id={name} class="first-of-type:rounded-t-lg first-of-type:overflow-hidden not-first-of-type:border-t border-base-200">
    <div>
        <dt class="flex bg-base-50 font-medium text-base-800 space-x-3 items-center border-base-200 border-b text-base md:text-lg px-4 py-2 md:py-3">
            <Icon name={icon} class="pointer-events-none left-4 top-[13px] h-7 w-7 md:h-8 md:w-8 rounded-full text-primary-500 inline-block bg-white border border-base-300 rounded-fill p-1" />
            <span>{title}</span></dt>
        <dl class="divide-y divide-base-200 px-4 md:px-6 py-4">
            <slot></slot>
        </dl>
    </div>
</section>